---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
---

<div
  id="hero"
  class="relative isolate overflow-hidden py-25 md:py-32 flex items-center w-full"
>
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <!-- Dark gradient overlay for readability -->
    <div
      class="absolute inset-0 bg-linear-to-b from-black/40 via-black/20 to-transparent"
    >
    </div>

    <!-- Grid -->
    <svg class="absolute inset-0 h-full w-full opacity-10 rotate-5">
      <defs>
        <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
          <path
            d="M 60 0 L 0 0 0 60"
            fill="none"
            stroke="white"
            stroke-width="1"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)"></rect>
    </svg>

    <!-- Glow orbs -->
    <div
      class="absolute -top-60 -left-60 h-150 w-150 rounded-full bg-blue-900/30 blur-3xl"
    >
    </div>

    <div
      class="absolute top-40 -right-40 h-80 w-80 rounded-full bg-purple-700/30 blur-2xl animate-pulse [animation-delay:1s]"
    >
    </div>

    <div
      class="absolute bottom-10 left-1/2 h-40 w-40 -translate-x-1/2 rounded-full bg-cyan-400/20 blur-xl animate-pulse [animation-delay:2s]"
    >
    </div>
  </div>
  <div
    class="mx-auto p-8 sm:p-12 md:p-24 grid grid-cols-1 md:grid-cols-2 gap-12 items-center h-full"
  >
    <!-- Content -->
    <div
      class="text-white/90 space-y-6 order-2 md:order-1 text-center md:text-left"
    >
      <h1
        class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-white"
      >
        Rusty Huskey
      </h1>
      <div
        class="mt-4 flex items-center gap-2 text-lg sm:text-xl text-white/65 justify-start text-left"
      >
        <Icon name="mdi:badge-account-outline" class="text-xl sm:text-2xl" /> Network
        and Systems Support Specialist
      </div>
      <div
        class="mt-2 flex items-center gap-3 text-base sm:text-lg text-white/65 justify-start text-left"
      >
        <Icon name="mdi:map-marker-radius" class="text-lg sm:text-2xl" /> Tennessee,
        USA
      </div>

      <div
        class="flex flex-row flex-wrap gap-3 mt-4 justify-center md:justify-start items-center"
      >
        <a
          href="#contact"
          class="inline-flex items-center px-4 py-2 sm:px-6 sm:py-3 rounded-xl bg-white text-black font-semibold hover:bg-white/90 transition backdrop-blur-sm"
        >
          <Icon name="mdi:email" class="text-black/70 text-lg mr-2" />
          Contact Me
        </a>

        <a
          href="#projects"
          class="inline-flex items-center px-4 py-2 sm:px-6 sm:py-3 rounded-xl bg-white/10 border border-white/10 hover:bg-white/20 text-gray-100 transition backdrop-blur-sm"
        >
          <Icon name="mdi:folder-open" class="text-white/60 text-lg mr-2" />
          View Projects
        </a>

        <a
          href="#credentials"
          class="inline-flex items-center px-4 py-2 sm:px-6 sm:py-3 rounded-xl bg-white/10 border border-white/10 hover:bg-white/20 text-gray-100 transition backdrop-blur-sm"
        >
          <Icon name="mdi:certificate" class="text-white/60 text-lg mr-2" />
          View Credentials
        </a>
      </div>
    </div>

    <!-- Visual / Avatar -->
    <div
      class="relative flex justify-center md:justify-end order-1 md:order-2 mb-6 md:mb-0"
    >
      <div class="w-72 h-72 md:w-96 md:h-96 rounded-3xl">
        <Image
          priority
          height="1080"
          width="1080"
          src="/img/profile.jpg"
          alt="Headshot"
          class="w-full h-full object-cover rounded-3xl shadow-2xl"
        />
      </div>
    </div>
  </div>

  <!-- scroll hint -->
  <div class="absolute inset-x-0 bottom-6 flex justify-center">
    <div class="animate-bounce text-white/70">
      <Icon name="mdi:chevron-down" class="text-3xl" />
    </div>
  </div>
</div>
