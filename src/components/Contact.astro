---
import { Icon } from "astro-icon/components";
---

<section id="contact" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <!-- Title -->
      <div class="lg:col-span-4">
        <h2
          class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-100"
        >
          Contact Me
        </h2>

        <p class="mt-4 text-white/50 text-base sm:text-lg leading-relaxed">
          Let’s Talk Business.
        </p>
      </div>

      <!-- Content -->
      <div class="lg:col-span-8 space-y-8">
        <!-- Email Card -->
        <div
          class="w-full p-4 sm:p-6 md:p-8 rounded-xl sm:rounded-2xl bg-gray-800/20 border border-white/5 backdrop-blur-sm"
        >
          <p class="text-white/70 text-xl">
            I'm always open to connecting with fellow IT professionals,
            discussing technology, and exploring new opportunities.
          </p>

          <div
            class="mt-3 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3"
          >
            <div class="flex items-center gap-3 w-full">
              <Icon name="mdi:email" class="text-white/60 text-xl" />
              <span class="text-white/80 text-base sm:text-lg select-text">
                rusty@huskey.cc
              </span>
              <button
                id="copy-email"
                type="button"
                aria-label="Copy email address"
                class="ml-1 inline-flex items-center justify-center p-2 rounded hover:text-white/80 text-white/20 transition focus:outline-none focus:ring-2 focus:ring-cyan-400"
                title="Copy email"
              >
                <span id="copy-state" aria-hidden="true">
                  <Icon id="copy-icon" name="mdi:content-copy" />

                  <Icon
                    id="check-icon"
                    name="mdi:check-bold"
                    class="hidden text-green-400"
                  />
                </span>
                <span id="copy-feedback" class="sr-only" aria-live="polite"
                ></span>
              </button>
            </div>

            <div class="w-full sm:w-auto shrink-0">
              <a
                href="mailto:rusty@huskey.cc?subject=Lets%20Talk%20Business&body=Hi%20Rusty%2C%0A%0AI%20came%20across%20your%20portfolio%20and%20wanted%20to%20reach%20out.%0A%0A[Message]%0A%0ABest%2C%0A[Name]"
                class="px-4 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-white text-sm sm:text-base transition focus:outline-none focus:ring-2 focus:ring-cyan-400 w-full sm:w-auto text-center block"
                rel="noopener noreferrer"
              >
                Send Email
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const copyBtn = document.getElementById("copy-email");
      const copyIcon = document.getElementById("copy-icon");
      const checkIcon = document.getElementById("check-icon");
      const feedback = document.getElementById("copy-feedback");

      if (!copyBtn) return;

      // Hide copy button if clipboard API is not available
      if (!navigator?.clipboard) {
        copyBtn.setAttribute("aria-hidden", "true");
        copyBtn.classList.add("hidden");
        return;
      }

      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText("rusty@huskey.cc");
          feedback &&
            (feedback.textContent = "Email address copied to clipboard");

          copyIcon && copyIcon.classList.add("hidden");
          checkIcon && checkIcon.classList.remove("hidden");

          setTimeout(() => {
            checkIcon && checkIcon.classList.add("hidden");
            copyIcon && copyIcon.classList.remove("hidden");
            feedback && (feedback.textContent = "");
          }, 2000);
        } catch (err) {
          feedback && (feedback.textContent = "Unable to copy email");
        }
      });
    })();
  </script>
</section>
